    "/tmdb/search": {
      "post": {
        "operationId": "tmdb-search",
        "summary": "Call tool: search",
        "description": "Search TMDB for movies, TV series, people, collections, companies, or keywords.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Session ID for the tool call. Get one from GET /api/sessionid"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "movie",
                      "tv",
                      "person",
                      "multi",
                      "collection",
                      "company",
                      "keyword"
                    ],
                    "default": "multi"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "include_adult": {
                    "type": "boolean"
                  },
                  "language": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "year": {
                    "type": "string"
                  },
                  "primary_release_year": {
                    "type": "string"
                  },
                  "first_air_date_year": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
